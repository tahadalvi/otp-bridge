# Copy to ~/otp-relay/.env on the relay host and chmod 600.
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OTP_PHONE_TOKEN=replace-me-write-only-token
OTP_PC_TOKEN=replace-me-read-only-token
OTP_PORT=8790
# Private-network address of this host (VPN / Tailscale / LAN); the PC agent connects here.
OTP_PRIVATE_IP=10.0.0.2
